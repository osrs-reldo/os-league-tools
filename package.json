{
  "name": "reldo-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@8.9.0",
  "engines": {
    "node": ">=20 <=22"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "start:backend": "node apps/api/dist/server.js"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,json,md,yml,yaml}": [
      "prettier --write"
    ],
    "apps/**/*.{js,jsx,ts,tsx,mjs,cjs}": [
      "sh -c 'pnpm turbo lint --filter=@repo/api --filter=@repo/web'"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@repo/eslint-config": "workspace:*",
    "@repo/tailwind-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "turbo": "^2.8.11"
  }
}
